# Repo-root reference for local development env vars consumed by api/.
# Copy the values you need into your shell / a real .env, or export them
# directly. Real secrets for staging/production are DigitalOcean App
# Platform encrypted secrets — never commit real values here.
# See api/README.md for the full table with descriptions.

DATABASE_URL=postgres://survivor:survivor@localhost:5432/survivor_league?sslmode=disable

# development | production — gates the refresh-token cookie's Secure flag
# (Secure cookies require HTTPS, which local dev over http doesn't have).
APP_ENV=development

# HS256 signing secret for access tokens.
# FAKE VALUE for local dev only — replace with a long random string in any
# real deployment, and never reuse this value outside your machine.
JWT_SECRET=dev-only-insecure-secret-change-me

# Case-insensitive match on this address during POST /auth/register grants
# is_site_admin=true to that user automatically (the site-admin bootstrap
# path). Leave unset to disable auto-bootstrap.
ADMIN_EMAIL=admin@example.com

# Origin the web app is served from, for the API's CORS allowlist. Must be
# an exact scheme+host+port match — wildcards don't work together with
# credentials: 'include' per browser spec.
CORS_ALLOWED_ORIGIN=http://localhost:5173

PORT=8080
